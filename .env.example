# KAFKA CONFIGURATION
KAFKA_CLUSTER_ID=8abHuBAiRtyB0XiVxBeO-g
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_NODE_ID=1
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_ZOOKEEPER_CONNECT=
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# KAFKA UI
KAFKA_UI_PORT=8085
KAFKA_CLUSTERS_0_NAME=local
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:9092

# POSTGRESQL DATABASE CONFIGURATION
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=flights
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=15432

# REDIS CONFIGURATION
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379

# ENCRYPTION & SECURITY
ENCRYPTION_KEY=your_base64_encrypted_key_here

# JWT CONFIGURATION
JWT_PUBLIC_KEY_PATH=Keys/public_key.pem
JWT_PRIVATE_KEY_PATH=Keys/private_key.pem
JWT_TOKEN_VALIDITY_MINS=2000
JWT_REFRESH_TOKEN_VALIDITY_MINS=2000

# RABBITMQ CONFIGURATION
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_EXCHANGE_NAME=notifications
RABBITMQ_QUEUE_MAIL=mail-service-queue
RABBITMQ_QUEUE_PDF=pdf-generator-queue
RABBITMQ_ROUTING_KEY_EMAIL_REGISTRATION=email.registration
RABBITMQ_ROUTING_KEY_EMAIL_BOOKING=email.booking_confirmed
RABBITMQ_ROUTING_KEY_PDF_GENERATE=pdf.generate_ticket

# MINIO (S3-COMPATIBLE OBJECT STORAGE) CONFIGURATION
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=boarding-passes
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
MINIO_EXTERNAL_API_PORT=9000
MINIO_EXTERNAL_CONSOLE_PORT=9001

# MICROSERVICES CONFIGURATION
FLIGHTS_SERVICE_PORT=8082
FLIGHTS_DATABASE_CONNECTION=Host=postgres;Port=5432;Database=flights;Username=postgres;Password=your_postgres_password
FLIGHTS_REDIS_CONNECTION=redis:6379
MAIL_SERVICE_PORT=8083
IDENTITY_SERVICE_PORT=8081
IDENTITY_DATABASE_CONNECTION=Host=postgres;Port=5432;Database=identity;Username=postgres;Password=your_postgres_password
BOARDING_PASSES_SERVICE_PORT=8084

# FRONTEND CONFIGURATION
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# SERVICE PORTS
FLIGHTS_PORT=your_flights_port
MAIL_PORT=your_mail_port
IDENTITY_PORT=your_identity_port
BOARDING_PASSES_PORT=your_boarding_passes_port
KAFKA_UI_EXTERNAL_PORT=your_kafka_ui_port
FRONTEND_EXTERNAL_PORT=your_frontend_port
POSTGRES_EXTERNAL_PORT=your_postgres_external_port
REDIS_EXTERNAL_PORT=your_redis_external_port
MINIO_API_EXTERNAL_PORT=your_minio_api_port
MINIO_CONSOLE_EXTERNAL_PORT=your_minio_console_port

# DOCKER VOLUME NAMES
PGDATA_VOLUME=pgdata
KAFKA_DATA_VOLUME=kafka_data
MINIO_DATA_VOLUME=minio_data